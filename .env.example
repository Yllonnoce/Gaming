# Copy to .env.local for development. Both values have working defaults, so
# `npm run dev` runs with no setup at all.

# Signs the identity cookie. REQUIRED in production -- the app refuses to boot
# without it, because an unset secret would silently reissue every visitor a
# new identity on each deploy. Generate one with:
#   openssl rand -hex 32
IDENTITY_SECRET=

# Local SQLite file by default. Point at a Turso database to make data survive
# deploys, with no code changes:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/gaming.db
DATABASE_AUTH_TOKEN=

# Noisy Room opens VDO.Ninja's Comms app for the audio itself. Point this at a
# pinned version (https://vdo.ninja/v27/comms.html), the comms.cam alias, or a
# self-hosted copy. Public, so it is baked into the client bundle.
NEXT_PUBLIC_COMMS_URL=https://vdo.ninja/comms.html
